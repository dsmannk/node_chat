//================= 기본 성능/환경 설정 ============
fund=false          # 'npm fund' 광고 메시지 숨김
audit=false         # 보안 취약점 검사 비활성화(개발 시 속도 상승)
progress=false      # 설치 중 진행바 숨김 (로그 깔끔)
save-exact=true     # package.json에 ^버전 대신 정확한 버전 저장
legacy-peer-deps=false # peerDependencies 충돌 시 무시 안함(=npm v7+ 기본)
engine-strict=false # engines 필드 버전 체크 무시 (EBADENGINE 회피용)

# ================= 캐시 및 설치 경로 ==============
cache=/home/node/.npm-cache
prefix=/home/node/.npm-global # 전역 설치 경로 (권한 충돌 방지)
package-lock=true             # lockfile 생성 유지 (CI/CD 재현성 보장)

# ================= 네트워크 설정 =================
fetch-retries=5
fetch-retry-factor=2
fetch-retry-maxtimeout=120000
fetch-timeout=60000
registry=https://registry.npmjs.org/

# ================= 로그 관련 ====================
loglevel=warn
color=true

# ================= 프록시 환경 (회사망/보안망 전용) ===========
; proxy=http://proxy.company.com:8080
; https-proxy=http://proxy.company.com:8080
; strict-ssl=false

# ================= 인증 토큰 (Private Registry 예시) ========
; //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
; @myorg:registry=https://npm.pkg.github.com