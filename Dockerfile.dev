# Dockerfile.dev
FROM node:22-alpine

# 유틸
RUN apk add --no-cache bash git

# 작업 디렉토리
WORKDIR /app

# npm 전역/캐시 경로 및 권한 준비
RUN mkdir -p /home/node/.npm-global /home/node/.npm-cache && \
    chown -R node:node /home/node /app

# 전역 바이너리 PATH
ENV PATH="/home/node/.npm-global/bin:${PATH}"

# 루트 패키지 메타는 복사하지 않음(루트 의존성 설치 스킵)
# 필요하면 나중에 COPY . . 이후 설치하도록 변경 가능

# 여기서부터 node 권한으로 실행해도 /app에 쓸 수 있음
USER node

# =========================================================
# ★ 공통 의존성 설치(루트 /app): express / mongoose / dotenv / body-parser
#    - 루트에 package.json이 없으면 생성 + type=module 지정
#    - /app/node_modules 에 설치 → 하위 폴더 어디서든 import 가능
# =========================================================
RUN set -eux; \
    if [ ! -f /app/package.json ]; then \
      npm init -y; \
      npm pkg set type="module" --silent; \
      npm pkg set name="node_chat_dev" --silent; \
    fi; \
    npm install express mongoose dotenv body-parser express-handlebars --no-audit --no-fund && \
    npm install -D nodemon --no-audit --no-fund   # <<< 추가: dev 시 nodemon 사용

# ---------------------------
# Express 준비 (chapter3/express-server)
# ---------------------------
#RUN mkdir -p /app/chapter3/express-server && \
#    cd /app/chapter3/express-server && \
#    [ -f package.json ] || npm init -y && \
#    npm pkg set name="express-server" --silent && \
#    npm pkg set type="module" --silent && \
#    npm install express@latest --no-audit --no-fund && \
#    [ -f server.js ] || printf "%s\n" \
#      "import express from 'express';" \
#      "const app = express();" \
#      "const PORT = process.env.PORT || 3000;" \
 #     "app.get('/', (req, res) => res.send('Hello from Express!'));" \
 #     "app.listen(PORT, () => console.log('[Express] listening on', PORT));" \
 #     > server.js

# ---------------------------
# Nest.js 준비 (chapter8/hello-nestjs)
# ---------------------------
RUN mkdir -p /app/chapter8/hello-nestjs/src && \
    cd /app/chapter8/hello-nestjs && \
    [ -f package.json ] || npm init -y && \
    npm pkg set name="hello-nestjs" --silent && \
    npm install @nestjs/core @nestjs/common @nestjs/platform-express reflect-metadata typescript --no-audit --no-fund && \
    npm install -D ts-node --no-audit --no-fund && \
    [ -f src/main.ts ] || printf "%s\n" \
      "import 'reflect-metadata';" \
      "import { NestFactory } from '@nestjs/core';" \
      "import { Module, Controller, Get } from '@nestjs/common';" \
      "" \
      "@Controller()" \
      "class AppController {" \
      "  @Get()" \
      "  getRoot(): string { return 'Hello from NestJS!'; }" \
      "}" \
      "" \
      "@Module({ controllers: [AppController] })" \
      "class AppModule {}" \
      "" \
      "async function bootstrap() {" \
      "  const app = await NestFactory.create(AppModule);" \
      "  const PORT = process.env.PORT || 3001;" \
      "  await app.listen(PORT);" \
      "  console.log(\`[NestJS] listening on \${PORT}\`);" \
      "}" \
      "bootstrap();" \
      > src/main.ts && \
    [ -f tsconfig.json ] || printf "%s\n" \
      "{" \
      '  "compilerOptions": {' \
      '    "module": "esnext",' \
      '    "target": "es2017",' \
      '    "moduleResolution": "node",' \
      '    "sourceMap": true,' \
      '    "outDir": "dist",' \
      '    "experimentalDecorators": true,' \
      '    "emitDecoratorMetadata": true,' \
      '    "strict": true,' \
      '    "skipLibCheck": true' \
      "  }," \
      '  "include": ["src/**/*"]' \
      "}" \
      > tsconfig.json

# ------------------------------------
# Mongoose CRUD 준비 (chapter7/board/app.js)
#  - express/mongoose/dotenv/body-parser 사전 설치
#  - 파일이 없으면 최소 package.json만 생성
# ------------------------------------
RUN mkdir -p /app/chapter7/board && \
    cd /app/chapter7/board && \
    [ -f package.json ] || (npm init -y && npm pkg set type="module" --silent && npm pkg set name="board" --silent) && \
    npm install express mongoose dotenv body-parser express-handlebars --no-audit --no-fund


# (선택) 나머지 소스 복사
COPY --chown=node:node . .

# ------------------------------------
# COPY 이후 실제 프로젝트 기준으로 종속성 동기화
#  - lockfile이 있으면 npm ci, 없으면 npm install
# ------------------------------------
# chapter7/board
RUN cd /app/chapter7/board && \
    if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi

# (필요하다면 chapter3/express-server, chapter8/hello-nestjs 도 동일 패턴으로 보강 가능)
# RUN cd /app/chapter3/express-server && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi
# RUN cd /app/chapter8/hello-nestjs && if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi

# 포트 노출 (Express 3000, Nest 3001)
EXPOSE 3000 3001

# 기본 실행: Express 서버
#CMD ["node", "chapter3/express-server/server.js"]
#CMD ["node", "chapter7/board/app.js"]
# 개발용 nodemon로 핫리로드 실행
CMD ["npx", "nodemon", "--legacy-watch", "chapter7/board/app.js"]
