# Dockerfile.dev
FROM node:22-alpine

# 작업 디렉토리
WORKDIR /app

# npm 전역/캐시 경로 및 권한 준비
RUN mkdir -p /home/node/.npm-global /home/node/.npm-cache && \
    chown -R node:node /home/node

# PATH에 전역 바이너리 추가 (변수는 ${PATH})
ENV PATH="/home/node/.npm-global/bin:${PATH}"

# 유저 전역 npm 설정을 복사
# COPY docker/node/.npmrc /home/node/.npmrc

# 먼저 package 메타만 복사해서 레이어 캐시 최적화
COPY package*.json ./

# node 유저로 전환 후 설치
USER node

# lockfile 있으면 ci, 없으면 install
RUN if [ -f package-lock.json ]; then \
        npm ci; \
    else \
        npm install; \
    fi

# 그 다음에 나머지 소스
COPY . .

# 소스는 볼륨 마운트로 들어올 예정(compose에서)
# 프레임워크별 기본 포트(Vite: 5173, Next.js / Express: 3000)
EXPOSE 3000 5173
CMD ["npm", "run", "dev"]